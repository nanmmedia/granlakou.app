/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/config.js
  Cache-Control: no-cache

/confirmed.html
  Cache-Control: no-store
  Referrer-Policy: no-referrer

/confirmed
  Cache-Control: no-store
  Referrer-Policy: no-referrer
